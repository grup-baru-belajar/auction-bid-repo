meta {
  name: NEGATIVE - kedua field kosong
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 400
}

tests {
  test("menyebut kedua field, berurutan", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().message).to.equal("Missing or invalid field: username, password");
  });
}
