meta {
  name: NEGATIVE - password salah
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{adminUser}}",
    "password": "password-yang-salah"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("401 dengan pesan generik", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().success).to.equal(false);
    expect(res.getBody().message).to.equal("Invalid username or password");
  });

  test("tidak ada token yang terbit", function() {
    expect(res.getBody().data).to.be.undefined;
  });

  bru.setVar("pesanPasswordSalah", res.getBody().message);
}

docs {
  Pesannya disimpan ke variable, lalu dibandingkan di request berikutnya.
}
