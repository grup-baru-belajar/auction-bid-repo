meta {
  name: NEGATIVE - password tidak diisi
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "admin"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("400 dan menyebut field yang kurang", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().message).to.equal("Missing or invalid field: password");
  });
}

docs {
  Ditangkap tag binding:"required", diterjemahkan respondBindError jadi
  pesan yang menyebut nama field-nya.
}
