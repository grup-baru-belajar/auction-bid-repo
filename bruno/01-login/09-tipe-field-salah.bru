meta {
  name: EDGE - tipe field salah
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/login
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  {"username":123,"password":"x"}
}

assert {
  res.status: eq 400
}

tests {
  test("angka di field string juga Malformed JSON body", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().message).to.equal("Malformed JSON body");
  });
}

docs {
  json.UnmarshalTypeError. Ditangani di cabang yang sama dengan SyntaxError.
}
