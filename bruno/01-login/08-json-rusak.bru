meta {
  name: EDGE - JSON rusak
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/login
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  {"username":}
}

assert {
  res.status: eq 400
}

tests {
  test("dikenali sebagai JSON malformed", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().message).to.equal("Malformed JSON body");
  });
}

docs {
  json.SyntaxError. Dibedakan dari body terpotong (request 10).
}
