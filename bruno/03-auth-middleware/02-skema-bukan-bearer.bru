meta {
  name: NEGATIVE - skema bukan Bearer
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/reporting/top-auction
  body: none
  auth: none
}

headers {
  Authorization: Token {{adminToken}}
}

assert {
  res.status: eq 401
}

tests {
  test("token sah pun ditolak kalau skemanya salah", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().message).to.equal("Unauthorized");
  });
}

docs {
  Middleware memecah header jadi dua bagian dan mewajibkan bagian
  pertama "bearer" (case-insensitive). "Token" ditolak.
}
